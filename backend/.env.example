# Copy to .env and adjust
APP_ENV=development
# Key required for every /api/isolated/* endpoint (send as X-API-Key header)
ISOLATED_API_KEY=change-me
# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# Playwright
HEADLESS=true
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=45000
MAX_CONCURRENT_SCRAPES=3
SCREENSHOT_ON_FAILURE=true
# Optional proxy — use if a bank site blocks your IP
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://offerwala:change-me@localhost:5432/offerwala
